# GENERATED by build_profile.py from tools/profile/z486_mister.sdc.in and the ACTIVE build
# configuration (the qsf's "# Active config" record). Do not edit the copy at the project
# root - it is git-ignored and rewritten on every profile switch. Edit the template; only the
# block between the PROFILE-SPECIFIC markers is computed (tools/profile_gen.py).
derive_pll_clocks
derive_clock_uncertainty

# Guard the active core/SDRAM PLL hierarchy. clk_sys is output 0, and the SDRAM controller and
# its PHY run on it too: there is ONE core clock and no clock-domain crossing to the SDRAM (the
# split-clock configuration, a dedicated clk_sdram on a third output behind a toggle/FIFO bridge,
# was removed on 2026-10-09). SDRAM_CLK is output 1,
# clk_sys's frequency phase-shifted so the device samples the controller's command/address and
# launches read data with setup. The phase is derived from the "SDRAM board I/O" model below
# (tools/profile_gen.py, derive_sdram_phase) unless the configuration overrides it.
set pc9821_clk_sys [get_clocks {emu|pll|pll_inst|altera_pll_i|general[0]*|divclk}]
set pc9821_clk_sdram_pin [get_pins {emu|pll|pll_inst|altera_pll_i|general[1]*|divclk}]
if {[llength $pc9821_clk_sys] != 1 ||
    [llength $pc9821_clk_sdram_pin] != 1} {
    error "PC9821: active core/SDRAM PLL clocks not found"
}

@PROFILE_SPECIFIC@

# No second clock domain: the PC-98 dot rate is an enable on clk_sys
# (pc9821_system's pixel_ce), not a separate clock. That is what the framework
# requires (developer/emu.md: the video clock must be above 40 MHz and CE_PIXEL
# must be based on CLK_VIDEO) and what the upstream template does, running its
# whole video chain from clk_sys with ce_pix = the core's enable. The dot-clock
# PLL, its asynchronous clock group and the clk_sys <-> video CDC are all gone
# with it; this core's clocks are the main PLL's outputs (clk_sys and the
# SDRAM pin clock), which sys/sys_top.sdc already groups.

# Detailed timing reports are produced by a separate STA session against the fitted
# database (create_timing_netlist; read_sdc; update_timing_netlist, then report_timing).
# They deliberately do NOT live here: the SDC is
# re-read on every build, and a mistake in it aborts the fitter outright
# (Error 332000 / 11802), which is a poor trade for reports the fitter log
# already prints.

# ------------------------- SDRAM board I/O -------------------------------
# Alliance AS4C32M16SB-7 limits used by the physically proven rollback:
# tAC 6.0 ns, tOH 2.5 ns, tDS 1.5 ns, tDH 0.8 ns. Commands/write data launch
# from the controller's clk_sys I/O registers and are sampled on the phase-shifted
# SDRAM_CLK. Read DQ launches from the SDRAM clock and is captured by the sole
# controller input register in sdram.v. Board skew is not yet characterized separately;
# these constraints use the full device limits and must be revisited with
# measured/board-level skew before declaring hardware acceptance.
create_generated_clock -name PC9821_SDRAM_CLK \
    -source $pc9821_clk_sdram_pin -divide_by 1 [get_ports SDRAM_CLK]

set pc9821_sdram_out [get_ports {SDRAM_A[*] SDRAM_BA[*] SDRAM_CKE \
    SDRAM_DQMH SDRAM_DQML SDRAM_DQ[*] SDRAM_nCAS SDRAM_nCS SDRAM_nRAS \
    SDRAM_nWE}]
set_output_delay -clock PC9821_SDRAM_CLK -max  1.5 $pc9821_sdram_out
set_output_delay -clock PC9821_SDRAM_CLK -min -0.8 $pc9821_sdram_out
set_input_delay -clock PC9821_SDRAM_CLK -max 6.0 [get_ports SDRAM_DQ[*]]
set_input_delay -clock PC9821_SDRAM_CLK -min 2.5 [get_ports SDRAM_DQ[*]]

# dq_r is the sole controller register that reads the DQ pins, packed into the input cell
# (FAST_INPUT_REGISTER), so this is not the ordinary single-cycle input path. The launch
# reference is the forwarded PC9821_SDRAM_CLK, whose path to the SDRAM_CLK pin runs through
# the output buffer (~13.8 ns from the PLL), while the controller clock reaches the dq_r input
# cell in ~8.5 ns: the two differ by 5.293 ns. Measured (on a 100 MHz split-clock build, when the
# controller still had its own clk_sdram) on the fitted seed-6 database
# (the report_sdram_timing.tcl dev tool): DQ data arrives at dq_r's D input at 26.3 ns and the
# controller's capture edges are at 18.5 / 28.5 ns. The single-cycle pairing would check the
# 18.5 ns edge, which PRECEDES the data, and reports a false -8.0 ns violation; READ/RMW_READ
# consume the first edge at or after the data (28.5 ns; sdram.v T_RCD+CAS+2), which is the
# setup-2 pairing, and it holds the correct halfword because the next one launches a full
# controller-clock period later. A derivation from a nominal +4 ns phase that ignores the
# output-path skew misplaces the consumed edge and is wrong.
set pc9821_sdram_dq_capture [get_registers {*dq_r[*]}]
if {[get_collection_size $pc9821_sdram_dq_capture] != 16} {
    error "PC9821: expected 16 packed SDRAM DQ input registers"
}
set_multicycle_path -from [get_ports SDRAM_DQ[*]] \
    -to $pc9821_sdram_dq_capture -setup 2
# NO hold multicycle on this pair (it carried `-hold 1` until the profile-gen lane). dq_r
# captures on EVERY controller-clock edge and the SDRAM drives a new halfword on every SDRAM_CLK
# edge, so this is a SHIFTED single-cycle capture, not data held for two cycles: the halfword
# consumed at the setup-2 edge must not be overtaken by the NEXT halfword, which is the same
# as this halfword not arriving before the edge one period earlier - and that is exactly the
# default hold check Quartus places after `-setup 2` (setup latch edge - one period).
# `-hold 1` moved that check back to the launch-adjacent edge and so reported +10 ns of hold
# where the real margin at 4000 ps was +0.016 ns at the slow 100C corner and negative at the
# others. The phase is now chosen to centre this window (tools/profile_gen.py).

# Reset/control-release paths. Previously written as
#   set_false_path -from [get_registers {*cpu_reset_n*}]
#   set_false_path -from [get_registers {*boot_done*}]
# and both matched nothing (cpu_reset_n is a *net*, boot_done does not exist in
# the fitted netlist), so they were silently inert: Warning 332049, reported
# once and then ignored. The reset exception is wanted, but it has to name
# objects that exist -- the two reset synchroniser chains.
#
# reset_sync_r is the clk_sys chain, and it is the whole exception: the SDRAM controller runs on
# clk_sys and takes reset_sync_r's release directly. (The split-clock build also carried
# resetn_sdram_r, the clock-domain bridge's clk_sdram re-synchroniser, named here until that
# configuration was removed.)
set pc9821_reset_regs [get_registers {*reset_sync_r*}]
if {[get_collection_size $pc9821_reset_regs] == 0} {
    error "PC9821: reset synchroniser registers not found"
}
set_false_path -from $pc9821_reset_regs

# Quasi-static OSD/load-time configuration: hps_io's 128-bit `status` word and
# `sdram_sz`. MiSTer re-sends the whole word on a UI command (core load, OSD
# setting, or one of the `R`/`T` action entries -- those arrive as LEVELS, 1 then
# 0, which pc9821_iobus edge-detects into the one-cycle DIP-store pulses its port
# comment documents), and the BIOS-set field is latched again at the core's
# reset/reload strobe. The real requirement on these bits is software pace --
# microseconds between changes at the closest -- not a single clk_sys edge, so
# timing every status -> core path (reset_req, pc9821_osd's RAM-size/vsync/BIOS
# decode, the joystick_dis decode) at one clock cycle is pure over-constraint.
# reset_req = buttons[1] | status[0] shows the asymmetry this removes: its
# `buttons` half (= cfg[1:0]) is already false-pathed both ways by
# sys/sys_top.sdc's `cfg[*]` pair, and the status half is the same class of
# signal. sdram_sz likewise (fixed per core load, r13/300 F1) feeds only the
# controller's row/bank geometry decode. Cut both directions, mirroring `cfg`.
# This is not a CDC handshake: hps_io writes both words on clk_sys and the HPS
# side crosses through the already-grouped h2f/spi interface.
set pc9821_status_regs  [get_registers {*hps_io|status[*]}]
set pc9821_sdramsz_regs [get_registers {*hps_io|sdram_sz[*]}]
if {[get_collection_size $pc9821_status_regs] == 0 ||
    [get_collection_size $pc9821_sdramsz_regs] == 0} {
    error "PC9821: quasi-static hps_io config registers not found"
}
set_false_path -from $pc9821_status_regs
set_false_path -to   $pc9821_status_regs
set_false_path -from $pc9821_sdramsz_regs
set_false_path -to   $pc9821_sdramsz_regs

# ---------------- Asynchronous CDC: named synchroniser exceptions -----------
#
# What the reported "-7.051 CDDA CDC" / "-6.277 vs_d1" paths actually are: an
# artifact of querying a raw `quartus_sta -t` session WITHOUT the project SDCs.
# Such a session auto-derives its clocks (TimeQuest prints "No user constrained
# generated clocks found", `derive_clocks -period 1.0` follows), so the
# sys/sys_top.sdc clock groups are absent and TimeQuest relates the three PLLs
# by common-base-period analysis - the mis-derived ~1 ns relationship between
# 24.576 MHz and 80 MHz in the report. Under that view EVERY cross-domain path
# fails by construction - the reset false paths below show slack -33.7 there -
# and the numbers move with the placement draw (this tree's draws: CDDA
# -7.051 / -6.391, vsync -6.277 / -5.907). The constrained flow (the fitter's
# STA, which reads sys/sys_top.sdc and this file) already cuts these crossings
# at the clock groups: the lightoc fit's own summary shows pll_audio +15.403 /
# pll_hdmi +0.179 setup (after-draw; +15.402/+0.170 in the before draw) and
# nothing at -7 ns. To reproduce the constrained
# view in a query session, run `read_sdc` after `create_timing_netlist`.
#
# Why these lines exist anyway: at these two seams the exception coverage has
# been IMPLICIT in sys/sys_top.sdc's `*[0].*` group patterns. This repo has
# been bitten twice by silently-inert pattern constraints (the
# cpu_reset_n/boot_done pair in the reset section above, and the upstream
# SW[*] brace bug in the upstream template), so the synchroniser
# stages are named explicitly here with existence guards: redundant with the
# clock groups while their patterns match, operative when they do not. Each
# -from is scoped to the ASYNC LAUNCH CLOCK ONLY, so no same-clock
# single-cycle path is cut (hard rule: no exception may mask one).
#
# 1) cdda 44.1 kHz tick. `clk_44100` (src/soc/cdda.v) is a CLK_AUDIO-domain
#    toggle from the fractional divider (`clk_44100_cnt_next`/`CLK_AUDIO_RATE`
#    on CLK_AUDIO, `AUDIO_CE` on the rising half); the clk_sys side syncs it
#    clk_d1 -> clk_d2, accepts a value only when both stages agree
#    (clk_d2 == clk_d1) and edge-detects on the result (old_clk & ~clk_d2).
#    clk_d1 is the first synchroniser stage and nothing else feeds it; the
#    32-bit sample data crosses separately on the held `audio_cdc` handshake
#    (cdc_vector_handshake_continuous in the same file), which is why only the
#    tick needs an exception.
set pc9821_clk_audio [get_clocks {pll_audio|pll_audio_inst|altera_pll_i|*[0]*|divclk}]
if {[llength $pc9821_clk_audio] != 1} {
    error "PC9821: pll_audio output clock not found"
}
#    The CD-DA path is BUILT ONLY WITH THE CD-ROM (z486_mister.sv CDDA_EN), so the guard asks
#    whether cdda exists at all first: absent, there is no crossing to cut; present without its
#    clk_d1, the pattern has gone inert and that is still an error.
if {[get_collection_size [get_registers -nowarn {*cdda_inst|*}]] > 0} {
    set pc9821_cdda_sync1 [get_registers -nowarn {*cdda_inst|clk_d1*}]
    if {[get_collection_size $pc9821_cdda_sync1] == 0} {
        error "PC9821: cdda clk_44100 synchroniser (clk_d1) not found"
    }
    set_false_path -from $pc9821_clk_audio -to $pc9821_cdda_sync1
}

# 2) HDMI TX vsync level. `hdmi_out_vs` (sys/sys_top.v:1300,1329) registers on
#    hdmi_tx_clk, the clkselect mux of clk_vid (= clk_sys in this core) and
#    hdmi_clk_out (pll_hdmi) (sys/sys_top.v:1263-1271); both legs are real at
#    runtime, so the source is asynchronous whenever the hdmi_clk_out leg is
#    selected and same-clock otherwise. The clk_sys side syncs it twice:
#    vs_d0 -> vs_d1 -> vs_d2 with a stability filter on the raw level
#    (sys/sys_top.v:544-548) and vsd -> vsd2 (sys/sys_top.v:1088-1093).
#    vs_d0 and vsd are first stages. vs_d1 is named too: the filter's compare
#    reaches its enable raw (:545), but the value it can load is only the
#    stage-1 sample, so the filter at worst advances/defers the level by one
#    clk_sys. Clock-scoped because the clk_vid leg's same-clock copies of
#    these paths are REAL single-cycle paths (measured +5.839/+8.892/+9.650 on
#    the lightoc draw) and must stay timed. The clk_100 telemetry chains at
#    sys/hps_io.sv:985 and :1020 are deliberately NOT named here: frozen
#    framework internals, covered by the same clock groups.
set pc9821_clk_hdmi [get_clocks {pll_hdmi|pll_hdmi_inst|altera_pll_i|*[0]*|divclk}]
if {[llength $pc9821_clk_hdmi] != 1} {
    error "PC9821: pll_hdmi output clock not found"
}
set pc9821_vs_sync_vsd0 [get_registers -nowarn {vs_d0*}]
set pc9821_vs_sync_vsd1 [get_registers -nowarn {vs_d1*}]
set pc9821_vs_sync_vsd  [get_registers -nowarn {vsd vsd~*}]
if {[get_collection_size $pc9821_vs_sync_vsd0] == 0} {
    error "PC9821: vsync synchroniser stage vs_d0 not found"
}
if {[get_collection_size $pc9821_vs_sync_vsd1] == 0} {
    error "PC9821: vsync synchroniser stage vs_d1 not found"
}
if {[get_collection_size $pc9821_vs_sync_vsd] == 0} {
    error "PC9821: vsync synchroniser stage vsd not found"
}
set pc9821_vs_sync1 [get_registers -nowarn {vs_d0* vs_d1* vsd vsd~*}]
set_false_path -from $pc9821_clk_hdmi -to $pc9821_vs_sync1

# The segmentation adder (seg_unit) reaches the early-read accept
# (early_rd_present) only through the mem_linear_addr mux's complex/microcode
# leg, while early_rd_present requires the NON-complex demand leg, so that one
# path is logically false. It needs no exception, and attempts to add one have
# only ever been inert:
#
#   worst setup path through *seg_unit|Add0*    : +2.456 ns
#   worst setup path through *early_rd_present* : +3.559 ns
#
# (measured 2026-09-11 on the fitted database via the sta_report.sh dev tool; the
# worst paths through those nets are ordinary address-unit paths, not the
# mutually-exclusive pair). An exception also cannot be stated correctly here:
# no pins match those nets, and TimeQuest expands a clock collection used in
# -from/-to to * and then rejects the assignment as "not specific enough
# (-from * -thru * -to * is not allowed)". Recorded so it is not re-added.
